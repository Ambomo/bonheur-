# Copie ce fichier en ".env" et modifie les valeurs

# Port du serveur
PORT=4000

# --- Base de données externe (obligatoire) -----------------------------------
# Ce projet utilise PostgreSQL. Recommandé : Neon (gratuit en permanence,
# contrairement à la base gratuite de Render qui expire au bout de 30 jours) :
# 1. Va sur https://neon.tech, crée un compte et un projet
# 2. Copie la "Connection string" fournie (commence par postgresql://)
# 3. Colle-la ci-dessous
DATABASE_URL=postgresql://utilisateur:motdepasse@hote.neon.tech/nom_de_la_base?sslmode=require

# Mot de passe administrateur INITIAL (utilisé une seule fois, au tout premier
# démarrage, pour créer le compte admin en base). Le modifier ici ensuite n'aura
# plus aucun effet : change le mot de passe depuis l'espace admin ou via la
# récupération par clé (voir CLE_DE_RECUPERATION.txt généré au premier lancement).
ADMIN_PASSWORD=change_moi_123

# Clé secrète pour signer les tokens de connexion admin (chaîne aléatoire longue)
JWT_SECRET=remplace_par_une_chaine_secrete_longue_et_aleatoire

# Origine autorisée pour le frontend (utile en production)
CORS_ORIGIN=*

# --- Connexion avec Google (optionnel) --------------------------------------
# Pour activer le bouton "Se connecter avec Google" sur la page admin :
# 1. Va sur https://console.cloud.google.com/apis/credentials
# 2. Crée un identifiant OAuth "ID client OAuth" de type "Application Web"
# 3. Ajoute http://localhost:4000 dans les "Origines JavaScript autorisées"
# 4. Colle l'identifiant client ci-dessous (se termine par .apps.googleusercontent.com)
GOOGLE_CLIENT_ID=

# Seul ce compte Google (ton adresse Gmail) pourra se connecter à l'admin.
ADMIN_EMAIL=ton-email@gmail.com
